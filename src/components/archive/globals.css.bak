@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-inter), system-ui, sans-serif;
  --font-mono: var(--font-jetbrains-mono), monospace;
  --font-pixel: var(--font-pixel), monospace;
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-border: var(--border);
  --color-ring: var(--ring);
  --radius-xs: calc(var(--radius) - 6px);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --radius: 0.5rem;
  --background: #09090B;
  --foreground: #ededed;
  --muted: #141414;
  --muted-foreground: #888;
  --accent: #06b6d4;
  --accent-foreground: #fff;
  --border: #27272A;
  --ring: rgba(6, 182, 212, 0.5);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.06) transparent;
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  html {
    scroll-behavior: smooth;
  }

  ::selection {
    background-color: rgba(6, 182, 212, 0.25);
    color: #fff;
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 4px;
  }
}

/* ─── Hero Grid Background ─── */
.hero-grid {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero-grid::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(ellipse 80% 50% at 50% 50%, black 30%, transparent 70%);
  -webkit-mask-image: radial-gradient(ellipse 80% 50% at 50% 50%, black 30%, transparent 70%);
}

.hero-grid::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,0.06) 0%, transparent 100%),
                    radial-gradient(1px 1px at 50% 60%, rgba(255,255,255,0.04) 0%, transparent 100%),
                    radial-gradient(1px 1px at 80% 25%, rgba(255,255,255,0.05) 0%, transparent 100%),
                    radial-gradient(1px 1px at 35% 70%, rgba(255,255,255,0.03) 0%, transparent 100%),
                    radial-gradient(1px 1px at 60% 45%, rgba(255,255,255,0.04) 0%, transparent 100%),
                    radial-gradient(1px 1px at 10% 80%, rgba(255,255,255,0.03) 0%, transparent 100%),
                    radial-gradient(1px 1px at 90% 70%, rgba(255,255,255,0.04) 0%, transparent 100%),
                    radial-gradient(1px 1px at 45% 15%, rgba(255,255,255,0.03) 0%, transparent 100%),
                    radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.02) 0%, transparent 100%),
                    radial-gradient(1px 1px at 15% 50%, rgba(255,255,255,0.03) 0%, transparent 100%);
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

/* ─── Hero Glow ─── */
.hero-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 900px;
  height: 400px;
  background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(6, 182, 212, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

/* ─── Decorative Corner Markers ─── */
.hero-corner {
  position: absolute;
  width: 28px;
  height: 28px;
  pointer-events: none;
  opacity: 0.3;
}

.hero-corner-tl {
  top: 2rem;
  left: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  border-left: 1px solid rgba(255, 255, 255, 0.15);
}

.hero-corner-tr {
  top: 2rem;
  right: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  border-right: 1px solid rgba(255, 255, 255, 0.15);
}

.hero-corner-bl {
  bottom: 2rem;
  left: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  border-left: 1px solid rgba(255, 255, 255, 0.15);
}

.hero-corner-br {
  bottom: 2rem;
  right: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  border-right: 1px solid rgba(255, 255, 255, 0.15);
}

/* ─── Announcement Badge ─── */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.375rem 0.875rem;
  border: 1px solid rgba(6, 182, 212, 0.25);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: #22d3ee;
  font-family: var(--font-mono);
  background: rgba(6, 182, 212, 0.04);
}

/* ─── Utility Classes ─── */

/* Heading - replaces generic cvh-heading, uses Inter for subheadings */
.cvh-heading {
  font-family: var(--font-inter), system-ui, sans-serif;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.05;
}

/* Pixel heading - for hero only */
.cvh-pixel-heading {
  font-family: var(--font-pixel), monospace;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.0;
}

.cvh-pixel-heading-light {
  font-family: var(--font-pixel), monospace;
  font-weight: 500;
  letter-spacing: -0.005em;
  line-height: 1.0;
}

/* Section label */
.cvh-label {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.6875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border: 1px solid rgba(6, 182, 212, 0.2);
  color: #22d3ee;
  font-family: var(--font-mono);
}

.cvh-label::before {
  content: '';
  width: 0.375rem;
  height: 0.375rem;
  border-radius: 9999px;
  background-color: #06b6d4;
}

/* Gradient text accent */
.cvh-gradient-text {
  background: linear-gradient(135deg, #67e8f9, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Card base */
.cvh-card {
  border: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.02);
  border-radius: 0.75rem;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.cvh-card:hover {
  border-color: rgba(6, 182, 212, 0.25);
  background: rgba(6, 182, 212, 0.03);
}

/* Primary button */
.cvh-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  font-weight: 600;
  font-size: 0.875rem;
  color: #fff;
  background: #0891b2;
  border: none;
  transition: background 0.15s ease, transform 0.15s ease;
  cursor: pointer;
  line-height: 1;
}

.cvh-btn-primary:hover {
  background: #0e7490;
}

.cvh-btn-primary:active {
  transform: scale(0.97);
}

/* Secondary button */
.cvh-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  font-weight: 500;
  font-size: 0.875rem;
  color: rgba(255, 255, 255, 0.65);
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.12);
  transition: border-color 0.15s ease, color 0.15s ease;
  cursor: pointer;
  line-height: 1;
}

.cvh-btn-secondary:hover {
  border-color: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* Ghost button */
.cvh-btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  padding: 0.5rem 0.75rem;
  font-weight: 500;
  font-size: 0.875rem;
  color: rgba(255, 255, 255, 0.5);
  transition: color 0.15s ease, background 0.15s ease;
  cursor: pointer;
  background: transparent;
  border: none;
  line-height: 1;
}

.cvh-btn-ghost:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.04);
}

/* Section spacing */
.section-padding {
  padding-top: 5rem;
  padding-bottom: 5rem;
}

@media (min-width: 768px) {
  .section-padding {
    padding-top: 7rem;
    padding-bottom: 7rem;
  }
}

/* ─── Documentation Styles ─── */
.doc-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

@media (min-width: 1024px) {
  .doc-layout {
    grid-template-columns: 220px 1fr;
    gap: 3rem;
  }
}

.doc-sidebar {
  display: none;
}

@media (min-width: 1024px) {
  .doc-sidebar {
    display: block;
    position: relative;
  }

  .doc-sidebar-inner {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding-right: 0.5rem;
  }
}

.doc-sidebar-open {
  display: block !important;
  position: fixed;
  bottom: 4rem;
  right: 1.5rem;
  z-index: 45;
  width: 280px;
  max-height: 60vh;
  background: #0d0d0d;
  border: 1px solid rgba(6, 182, 212, 0.2);
  border-radius: 0.75rem;
  padding: 1.25rem;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}

.doc-toc-item {
  display: block;
  width: 100%;
  text-align: left;
  padding: 0.375rem 0.75rem;
  font-size: 0.8125rem;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.45);
  border-radius: 0 0.25rem 0.25rem 0;
  transition: all 0.15s ease;
  cursor: pointer;
  background: none;
  border: none;
  border-left: 2px solid transparent;
}

.doc-toc-item:hover {
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.03);
}

.doc-toc-sub {
  padding-left: 1.5rem;
  font-size: 0.75rem;
}

.doc-toc-active {
  color: #22d3ee !important;
  border-left-color: #06b6d4 !important;
  background: rgba(6, 182, 212, 0.08) !important;
}

.doc-icon-badge {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 0.625rem;
  background: rgba(6, 182, 212, 0.12);
  border: 1px solid rgba(6, 182, 212, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.doc-header-divider {
  height: 1px;
  background: linear-gradient(90deg, rgba(6, 182, 212, 0.3), transparent);
}

[id] {
  scroll-margin-top: 4.5rem;
}

/* ─── Marquee ─── */
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes marquee-reverse {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

.animate-marquee {
  animation: marquee 50s linear infinite;
}

.animate-marquee-reverse {
  animation: marquee-reverse 50s linear infinite;
}

.animate-marquee:hover,
.animate-marquee-reverse:hover {
  animation-play-state: paused;
}

/* ─── Content body (markdown pages) ─── */
.content-body {
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.75;
}

.content-body h2 {
  font-size: 1.5rem;
  font-weight: 700;
  color: white;
  margin-top: 3rem;
  margin-bottom: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.content-body h3 {
  font-size: 1.25rem;
  font-weight: 600;
  color: white;
  margin-top: 2rem;
  margin-bottom: 0.75rem;
}

.content-body p { margin-bottom: 1rem; }
.content-body ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
.content-body ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1rem; }
.content-body li { margin-bottom: 0.5rem; }

.content-body a {
  color: #22d3ee;
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.15s ease;
}

.content-body a:hover { color: #67e8f9; }

.content-body strong { color: white; font-weight: 600; }

.content-body code {
  background: rgba(255, 255, 255, 0.08);
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  color: #22d3ee;
  font-size: 0.875rem;
  font-family: var(--font-mono);
}

.content-body pre {
  background: rgba(255, 255, 255, 0.04);
  padding: 1rem;
  border-radius: 0.5rem;
  overflow-x: auto;
  border: 1px solid rgba(255, 255, 255, 0.06);
  margin-bottom: 1rem;
}

.content-body pre code { background: none; padding: 0; color: rgba(255, 255, 255, 0.8); }

.content-body blockquote {
  border-left: 3px solid #06b6d4;
  padding: 0.75rem 1rem;
  margin: 1.5rem 0;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(6, 182, 212, 0.05);
  border-radius: 0 0.5rem 0.5rem 0;
}

.content-body hr { border-color: rgba(255, 255, 255, 0.08); margin: 2rem 0; }

/* ─── Loading Screen ─── */
@keyframes loading-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

@keyframes loading-progress {
  0% { width: 0%; }
  100% { width: 100%; }
}

@keyframes loading-fade {
  0% { opacity: 1; }
  100% { opacity: 0; pointer-events: none; }
}
